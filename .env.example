PACER_CLIENT_ID=
PACER_CLIENT_SECRET=
PACER_AUTH_BASE_URL=https://developer.mypacer.com
PACER_API_BASE_URL=https://openapi.mypacer.com
PACER_REDIRECT_URI=https://your-app-name.onrender.com/pacer/callback

# Penyimpanan utama aplikasi. Format: postgresql://user:password@host:port/dbname
# (Render Postgres, Supabase, Neon, Railway, dll semua expose format ini). Tabel
# dibuat otomatis saat aplikasi start (idempoten, aman di-restart kapan saja).
DATABASE_URL=postgresql://user:password@host:5432/pacer_tracker

FLASK_SECRET_KEY=ganti-dengan-random-string-panjang

LOGIN_USERNAME=admin
LOGIN_PASSWORD=ganti-password-ini

# Token rahasia untuk trigger sync dari cron eksternal (mis. cron-job.org) via
# endpoint /sync/cron, tanpa perlu login. Kosongkan untuk menonaktifkan endpoint ini.
CRON_SYNC_TOKEN=ganti-dengan-random-string-panjang

# Auto-logout kalau tidak ada aktivitas selama sekian menit (default 60 = 1 jam)
SESSION_TIMEOUT_MINUTES=60

# Werkzeug debug mode - WAJIB false di production (risiko remote code execution
# kalau aktif dan ter-expose ke publik). Set true hanya untuk development lokal.
FLASK_DEBUG=false

# --- Legacy: Google Sheets ----------------------------------------------------
# HANYA dipakai oleh scripts/migrate_from_sheets.py (migrasi satu kali ke
# Postgres). Bisa dihapus dari environment production setelah migrasi selesai
# dan diverifikasi.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google-service-account.json
GOOGLE_SHEET_ID=
GOOGLE_SHEET_WORKSHEET=Raw_Pacer
GOOGLE_SHEET_HISTORY_WORKSHEET=Raw_Pacer_History
GOOGLE_MEMBERS_SHEET_ID=
GOOGLE_MEMBERS_WORKSHEET=Members
