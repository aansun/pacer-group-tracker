PACER_CLIENT_ID=
PACER_CLIENT_SECRET=
PACER_AUTH_BASE_URL=http://developer.mypacer.com
PACER_API_BASE_URL=http://openapi.mypacer.com
PACER_REDIRECT_URI=https://your-app-name.onrender.com/pacer/callback

# Isi salah satu:
# - GOOGLE_SERVICE_ACCOUNT_JSON: seluruh isi file JSON service account, dipadatkan jadi satu baris (dipakai di Render)
# - GOOGLE_SERVICE_ACCOUNT_FILE: path ke file JSON (dipakai untuk dev lokal saja, jangan commit filenya)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google-service-account.json
GOOGLE_SHEET_ID=
GOOGLE_SHEET_WORKSHEET=Raw_Pacer

# Spreadsheet TERPISAH khusus token anggota (private, JANGAN share ke tim - hanya service account + admin)
GOOGLE_MEMBERS_SHEET_ID=
GOOGLE_MEMBERS_WORKSHEET=Members

FLASK_SECRET_KEY=ganti-dengan-random-string-panjang

LOGIN_USERNAME=admin
LOGIN_PASSWORD=ganti-password-ini
